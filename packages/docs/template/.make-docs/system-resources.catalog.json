{
  "$schema": "./system-resources.schema.json",
  "schemaVersion": 1,
  "pathBase": "template-root",
  "identityTemplate": "make-docs://system/{type}/{path}",
  "defaultMediaType": "text/markdown; charset=utf-8",
  "resourceTypes": [
    {
      "type": "contract",
      "sourceRoot": ".make-docs/system/contracts",
      "include": [
        "*.md"
      ],
      "exclude": [
        "AGENTS.md",
        "CLAUDE.md",
        "playbook-contract.md"
      ]
    },
    {
      "type": "prompt",
      "sourceRoot": ".make-docs/system/prompts",
      "include": [
        "*.md"
      ],
      "exclude": [
        "AGENTS.md",
        "CLAUDE.md"
      ]
    },
    {
      "type": "reference",
      "sourceRoot": ".make-docs/system/references",
      "include": [
        "*.md"
      ],
      "exclude": [
        "AGENTS.md",
        "CLAUDE.md"
      ]
    },
    {
      "type": "template",
      "sourceRoot": ".make-docs/system/templates",
      "include": [
        "*.md"
      ],
      "exclude": [
        "AGENTS.md",
        "CLAUDE.md"
      ]
    }
  ],
  "systemWorkflows": [
    {
      "id": "naive-uat",
      "contracts": [
        "make-docs://system/contract/naive-uat-contract.md"
      ],
      "prompts": [
        "make-docs://system/prompt/naive-uat-facilitator.prompt.md",
        "make-docs://system/prompt/naive-uat-tester.prompt.md"
      ],
      "references": [
        "make-docs://system/reference/naive-uat-workflow.md"
      ],
      "templates": [
        "make-docs://system/template/naive-uat-scenario.md"
      ]
    }
  ],
  "preservedLegacyPaths": [
    ".make-docs/contracts/system/playbook-contract.md",
    "docs/assets/playbooks/**"
  ]
}
