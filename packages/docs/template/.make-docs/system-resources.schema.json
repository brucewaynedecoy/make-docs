{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://make-docs.local/schema/system-resources.schema.json",
  "title": "Make Docs System Resource Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "pathBase",
    "identityTemplate",
    "defaultMediaType",
    "resourceTypes",
    "systemWorkflows",
    "preservedLegacyPaths"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "pathBase": {
      "const": "template-root"
    },
    "identityTemplate": {
      "const": "make-docs://system/{type}/{path}"
    },
    "defaultMediaType": {
      "const": "text/markdown; charset=utf-8"
    },
    "resourceTypes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "type": {
                "const": "contract"
              }
            },
            "required": [
              "type"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "type": {
                "const": "prompt"
              }
            },
            "required": [
              "type"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "type": {
                "const": "reference"
              }
            },
            "required": [
              "type"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "type": {
                "const": "template"
              }
            },
            "required": [
              "type"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ],
      "items": {
        "$ref": "#/$defs/resourceType"
      }
    },
    "systemWorkflows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/systemWorkflow"
      }
    },
    "preservedLegacyPaths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/templatePath"
      }
    }
  },
  "$defs": {
    "templatePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$)).+$"
    },
    "resourceUri": {
      "type": "string",
      "pattern": "^make-docs://system/(contract|prompt|reference|template)/(?!/)(?!.*\\\\)(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))[^#?]+$"
    },
    "resourceType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "sourceRoot",
        "include",
        "exclude"
      ],
      "properties": {
        "type": {
          "enum": [
            "contract",
            "prompt",
            "reference",
            "template"
          ]
        },
        "sourceRoot": {
          "$ref": "#/$defs/templatePath"
        },
        "include": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exclude": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "systemWorkflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "contracts",
        "prompts",
        "references",
        "templates"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "contracts": {
          "$ref": "#/$defs/resourceUriList"
        },
        "prompts": {
          "$ref": "#/$defs/resourceUriList"
        },
        "references": {
          "$ref": "#/$defs/resourceUriList"
        },
        "templates": {
          "$ref": "#/$defs/resourceUriList"
        }
      }
    },
    "resourceUriList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/resourceUri"
      }
    }
  }
}
