{
  "name": "@brucewaynedecoy/make-docs",
  "version": "1.0.0-rc.1",
  "description": "Drop-in documentation structure, templates, and AI agent instructions with an NPX installer.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brucewaynedecoy/make-docs.git"
  },
  "homepage": "https://github.com/brucewaynedecoy/make-docs#readme",
  "bugs": {
    "url": "https://github.com/brucewaynedecoy/make-docs/issues"
  },
  "type": "module",
  "bin": {
    "make-docs": "dist/index.js"
  },
  "files": [
    "dist",
    "template",
    "skill-registry.json",
    "skill-registry.schema.json",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "validate:defaults": "vitest run tests/consistency.test.ts",
    "conformance:kit": "tsx scripts/conformance-kit.ts",
    "prepack": "node ../../scripts/copy-template-to-cli.mjs && npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@clack/core": "^1.1.0",
    "@clack/prompts": "^1.1.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
